FROM python:3.12-slim
ENV OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 PYTHONDONTWRITEBYTECODE=1 \
    MPLCONFIGDIR=/tmp/matplotlib HOME=/tmp GOMAXPROCS=1 GOCACHE=/tmp/go-cache GOPATH=/tmp/go
RUN apt-get update && apt-get install -y --no-install-recommends \
    nodejs r-base-core r-cran-jsonlite r-cran-data.table r-cran-ggplot2 \
    r-cran-mass r-cran-matrix golang-go g++ nlohmann-json3-dev \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-worker.txt /tmp/requirements-worker.txt
RUN pip install --no-cache-dir -r /tmp/requirements-worker.txt && rm /tmp/requirements-worker.txt
COPY internal/research/runtimes.json /opt/kairo/runtimes.json
USER 65534:65534
WORKDIR /tmp
CMD ["python3", "--version"]
